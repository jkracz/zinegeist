{
	"name": "zinegeist",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n web,convex -c blue,magenta \"vite dev --port 5296\" \"bunx convex dev\"",
		"dev:web": "vite dev --port 5296",
		"build:vercel": "bunx convex deploy --cmd 'bun run build' --cmd-url-env-var-name PUBLIC_CONVEX_URL",
		"build": "vite build",
		"preview": "vite preview --port 5296",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:convex": "bunx convex typecheck",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.4.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.4"
	},
	"dependencies": {
		"@convex-dev/aggregate": "^0.2.2",
		"@convex-dev/better-auth": "^0.12.5",
		"@convex-dev/polar": "^0.9.2",
		"@embedpdf/core": "^2.14.4",
		"@embedpdf/engines": "^2.14.4",
		"@embedpdf/plugin-document-manager": "^2.14.4",
		"@embedpdf/plugin-render": "^2.14.4",
		"@embedpdf/plugin-scroll": "^2.14.4",
		"@embedpdf/plugin-spread": "^2.14.4",
		"@embedpdf/plugin-viewport": "^2.14.4",
		"@embedpdf/plugin-zoom": "^2.14.4",
		"@mmailaender/convex-better-auth-svelte": "^0.8.2",
		"@mmailaender/convex-svelte": "^0.19.1",
		"better-auth": "1.6.23",
		"convex": "^1.42.1",
		"convex-helpers": "^0.1.120",
		"nanoid": "^6.0.0",
		"posthog-js": "^1.399.5",
		"posthog-node": "^5.41.0"
	}
}
